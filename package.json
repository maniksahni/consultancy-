{
  "name": "althea-consulting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "NEXT_PUBLIC_SITE_URL=https://altheaconsulting.in ALTHEA_BUILD=1 next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "deploy": "npm run typecheck && npm run build && firebase deploy --only hosting --project consultancyworld2 --non-interactive"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "lucide-react": "^0.439.0",
    "next": "^14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "lighthouse": "^12.8.2",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.45",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.4"
  }
