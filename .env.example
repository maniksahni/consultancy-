# Consultation submission opens WhatsApp; it does not use Firebase.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_RETENTION_DAYS=
# Canonical production domain. Production builds set this automatically.
NEXT_PUBLIC_SITE_URL=https://altheaconsulting.in
# Optional Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
